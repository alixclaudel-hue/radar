# Copier en .env sur le serveur et remplir. NE PAS committer .env.
# Docker compose lit ce fichier nativement ; un lancement CLI direct sur l'hôte
# le lit aussi : _key_from_dotenv (PR #193) pour GEMINI_API_KEY, et le repli
# _dotenv_lookup de scripts/ai/providers.py pour toutes les clés ci-dessous.

# ─── Accès web (owner-only) ────────────────────────────────────────────────
APP_PASSWORD=choisis-un-mot-de-passe-solide
APP_SESSION_SECRET=
OWNER_USERNAME=
RADAR_UID=
RADAR_NO_AUTH=
RADAR_SECURE_COOKIE=1
RADAR_WEB_BIND=127.0.0.1
RADAR_DOMAIN=

# ─── Sources tierces ───────────────────────────────────────────────────────
DISCOGS_TOKEN=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
BANDCAMP_SUB_USER=
BANDCAMP_SUB_PASS=

# ─── Délégation Gemini (règle N°1 de CLAUDE.md, scripts/ai_query.py) ──────
# Clé gratuite sur https://aistudio.google.com/apikey. Requise sur le VPS.
GEMINI_API_KEY=
# Override optionnel : URL de base d'un gateway local Gemini (cf. pt 44 de
# CLAUDE.md). Sur le VPS, la laisser vide → appel direct à Google.
RADAR_GEMINI_BASE_URL=
RADAR_GEMINI_GATEWAY_HOST=
RADAR_GEMINI_GATEWAY_PORT=
# TTL (secondes) d'un reçu Gemini côté hook gemini_gate.py (défaut 3600).
RADAR_GEMINI_GATE_TTL=
# Longueur minimale du prompt d'un reçu « ok » pour débloquer le gate
# (défaut 50 ; garde-fou anti gate-gaming, pt 47). 0 désactive le seuil.
RADAR_GEMINI_GATE_MIN_CHARS=

# ─── Délégation multi-fournisseurs (RÈGLE N°1 — scripts/ai_broker.py) ─────
# Gemini reste le transport direct ci-dessus ; ai_broker.py ajoute le routage
# « gratuit d'abord » puis l'escalade payante sur critère explicite. Un
# fournisseur sans clé déclarée est simplement ignoré, jamais une erreur. La
# rotation de clés prend la première définie de la liste (ordre du catalogue).
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# Plafond payant journalier en USD. VIDE = 0,00 $ : aucun appel payant ne part
# tant que ce plafond n'est pas déclaré (scripts/ai/quota.py, paid_cap_usd()).
RADAR_AI_DAILY_PAID_CAP_USD=
# Dossier d'usage (ledger de quota + disjoncteur santé). Défaut : le dossier des
# reçus (RADAR_TELEMETRY_DIR) ; sur le VPS, viser /data/ops/ai pour que radar_ops
# lise le même état que le courtier.
RADAR_AI_USAGE_DIR=
# Catalogue de modèles (défaut : config/ai_models.json du dépôt).
RADAR_AI_CATALOGUE=
# Cache disque du mode `context` (défaut : sous le dossier d'usage).
RADAR_AI_CONTEXT_CACHE=

# ─── Feedback / GitHub ─────────────────────────────────────────────────────
# PAT fine-grained pour les issues auto (feedback utilisateur → GitHub).
RADAR_FEEDBACK_GH_TOKEN=

# ─── Chemins de données et jobs (défauts fixés par paths.py) ──────────────
# Défaut : <repo>/data (identique en local et dans le volume Docker ./data:/data).
CRATE_DATA_DIR=

# ─── Drapeaux fonctionnels (défaut = 0/False si absent) ────────────────────
RADAR_AUTO_MAINTENANCE=
RADAR_RECOS_SCAN=
RADAR_RECO_INDEX=
RADAR_CATALOG_LABELGRAPH=
RADAR_SELLER_SCAN=
RADAR_DISCOGS_DUMP_SYNC=
RADAR_SCORESTORE=

# ─── Télémétrie du développement (radar_ops lot 2, pt 43 de CLAUDE.md) ────
# Où le hook de télémétrie écrit ; défaut = .claude/ dans le repo. Sur le VPS
# une session directe doit pointer sur /data/ops pour ne pas salir le checkout.
RADAR_TELEMETRY_DIR=
RADAR_TELEMETRY_PROMPTS=
# Dossier des journaux LUS par radar_ops (défaut <data>/ops) ; utile quand la
# session tourne dans un checkout sans /data monté (radar-work).
RADAR_OPS_TELEMETRY_DIR=

# ─── Fixé par deploy.yml (aller ET rollback) ; ne pas remplir à la main ────
RADAR_CODE_SHA=
