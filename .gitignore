# secrets & données (jamais dans git — elles vivent sur le volume du serveur)
.env
# sauvegardes horodatées du .env faites par la session VPS avant de basculer un
# drapeau RADAR_* (cf. .claude/skills/vps-ops/SKILL.md) : contiennent les mêmes
# secrets que le .env lui-même.
.env.bak-*
/data/
# garde-fou : défaut normalement /data/ (cf. pt 44 CLAUDE.md) mais si jamais
# écrit ici (vieux CRATE_DATA_DIR exporté vers la racine, ancien comportement...)
# ça contiendrait users/<uid>/crate_radar_config.json avec le token Discogs.
/users/
/shared/
accounts.json
invites.json
crate_radar_config.json
labels_resolved.json
labels_profile.json
labels_profile_*.json
taste_corpus.json
lookup_cache.json
producer_graph.json
artists_resolved.json
collection_cache.json
search_history.json
search_results.json
reco_feedback.json
sellers_seen.json
seller_new.json
scoring_profiles.json
djset_seen.json
jobs/
*.bak
*.bak2
*.tmp

# python
__pycache__/
*.pyc
.venv/
venv/

.DS_Store

# fichiers de file d'attente / cache veille (données locales)
pending_enrich.json
veille_new.json
veille_seen.json
sellers_seen.json
seller_new.json
canonicalize.state.json

# session navigateur capturée (secrets)
discogs_state.json
discogs_profile/

# le jeu de données exemple est versionné, lui
!/data.sample/
!/data.sample/**

.session_secret

# worktrees des sub-agents Claude Code (session cloud) — jamais du contenu à versionner
.claude/worktrees/

# reçus de délégation Gemini (cf. RÈGLE N°1 de CLAUDE.md) : état de session lu par
# le hook gemini_gate.py, régénéré à chaque appel — rien à versionner
.claude/gemini-receipts.jsonl

# télémétrie de développement (lot 2 radar_ops) : écrite par scripts/hooks/telemetry.py,
# expédiée sur la branche `telemetry` par telemetry_ship.py — jamais sur une branche de code
.claude/telemetry.jsonl
.claude/telemetry.jsonl.1
